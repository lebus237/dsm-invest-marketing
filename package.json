{
  "name": "dsm-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:capitalecho": "turbo run dev --filter=@dsm/capitalecho",
    "dev:dsm-invest": "turbo run dev --filter=@dsm/dsm-invest",
    "build": "turbo run build --concurrency=1",
    "build:capitalecho": "turbo run build --filter=@dsm/capitalecho",
    "build:dsm-invest": "turbo run build --filter=@dsm/dsm-invest",
    "start:capitalecho": "turbo run start --filter=@dsm/capitalecho",
    "start:dsm-invest": "turbo run start --filter=@dsm/dsm-invest",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "turbo": "^2.11.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
